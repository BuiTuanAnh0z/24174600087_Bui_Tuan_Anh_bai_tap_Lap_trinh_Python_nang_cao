# ===== BÀI 3.2 =====
print("=" * 50)
print("BÀI 3.2: Tạo và xử lý mảng cơ bản")
print("=" * 50)

# 1. Tạo mảng arr từ 0-9
arr = np.arange(10)
print("1. arr từ 0-9:", arr)
print("   Kiểu dữ liệu:", arr.dtype)
print("   Kích thước:", arr.shape)

# 2. Tạo arr_odd và arr_even
arr_odd = arr[arr % 2 == 1]
arr_even = arr[arr % 2 == 0]
print("\n2. arr_odd (số lẻ):", arr_odd)
print("   arr_even (số chẵn):", arr_even)

# 3. Tạo arr_update_1
arr_update_1 = np.where(arr % 2 == 0, arr, 100)
print("\n3. arr_update_1 (chẵn giữ nguyên, lẻ thay bằng 100):")
print("   ", arr_update_1)
print()

# ===== BÀI 3.3 =====
print("=" * 50)
print("BÀI 3.3: Thao tác với nhiều mảng")
print("=" * 50)

arr_a = np.array([1, 2, 3, 2, 3, 4, 3, 4, 5, 6])
arr_b = np.array([7, 2, 10, 2, 7, 4, 9, 4, 9, 8])

# 1. arr_c: phần tử xuất hiện ở cả hai mảng
arr_c = np.intersect1d(arr_a, arr_b)
print("1. arr_c (phần tử chung):", arr_c)

# 2. arr_d: chỉ xuất hiện ở arr_a
arr_d = np.setdiff1d(arr_a, arr_b)
print("\n2. arr_d (chỉ có trong arr_a):", arr_d)

# 3. arr_f: giá trị từ 5 đến 10 trong arr_e
arr_e = np.array([2, 6, 1, 9, 10, 3, 27, 8, 6, 25, 16])
arr_f = arr_e[(arr_e >= 5) & (arr_e <= 10)]
print("\n3. arr_f (giá trị từ 5 đến 10 trong arr_e):", arr_f)
print()

# ===== BÀI 3.4 =====
print("=" * 50)
print("BÀI 3.4: Thao tác cập nhật mảng")
print("=" * 50)

# 1. arr_zeros
arr_zeros = np.zeros(10)
arr_zeros[4] = 1
print("1. arr_zeros (vị trí 5 = 1):", arr_zeros)

# 2. arr_h đảo ngược
arr_h = np.arange(10, 25)
print("\n2. arr_h đảo ngược:", arr_h[::-1])

# 3. arr_l khác 0
arr_k = np.array([1, 2, 0, 8, 2, 0, 1, 3, 0, 5, 0])
arr_l = arr_k[arr_k != 0]
print("\n3. arr_l (các phần tử khác 0):", arr_l)

# 4. Thêm 10 và 20 vào cuối
arr_l = np.append(arr_l, [10, 20])
print("\n4. Thêm 10, 20 vào cuối:", arr_l)

# 5. Thêm 100 vào index = 5
arr_l = np.insert(arr_l, 5, 100)
print("\n5. Thêm 100 vào index 5:", arr_l)

# 6. Xóa index 0, 1, 2
arr_l = np.delete(arr_l, [0, 1, 2])
print("\n6. Xóa index 0, 1, 2:", arr_l)
print()

# ===== BÀI 3.5 =====
print("=" * 50)
print("BÀI 3.5: Xử lý dữ liệu MLB (Chiều cao và cân nặng)")
print("=" * 50)

# Tạo dữ liệu mẫu (100 cầu thủ)
np.random.seed(123)
height_inches = np.random.randint(65, 85, 100)  # 65-84 inches
weight_pounds = np.random.randint(160, 250, 100)  # 160-249 pounds

# 1. Tạo arr_height
arr_height = np.array(height_inches)
print("1. arr_height (inches) - 5 giá trị đầu:", arr_height[:5])

# 2. Tạo arr_weight
arr_weight = np.array(weight_pounds)
print("\n2. arr_weight (pounds) - 5 giá trị đầu:", weight_pounds[:5])

# 3. Đổi sang mét
inch_to_m = 0.0254
arr_height_m = arr_height * inch_to_m
print("\n3. arr_height_m (mét) - 5 giá trị đầu:", arr_height_m[:5])

# 4. Đổi sang kg
pound_to_kg = 0.453592
arr_weight_kg = arr_weight * pound_to_kg
print("\n4. arr_weight_kg (kg) - 5 giá trị đầu:", arr_weight_kg[:5])

# 5. Tính BMI
arr_bmi = arr_weight_kg / (arr_height_m ** 2)
print("\n5. arr_bmi - 5 giá trị đầu:", arr_bmi[:5])

# 6. Cân nặng index 50
print("\n6. Cân nặng tại index 50:", arr_weight_kg[50], "kg")

# 7. arr_height_m từ index 100-110
if len(arr_height_m) > 110:
    arr_height_m_100 = arr_height_m[100:111]
    print("\n7. arr_height_m từ index 100-110:", arr_height_m_100)
else:
    print("\n7. Không đủ dữ liệu cho index 100-110")

# 8. Cầu thủ có BMI < 21
bmi_under_21 = arr_bmi[arr_bmi < 21]
print("\n8. Số cầu thủ có BMI < 21:", len(bmi_under_21))
if len(bmi_under_21) > 0:
    print("   Giá trị BMI < 21 (5 giá trị đầu):", bmi_under_21[:5])

# 9. Trung bình
print("\n9. Chiều cao trung bình:", np.mean(arr_height_m), "m")
print("   Cân nặng trung bình:", np.mean(arr_weight_kg), "kg")

# 10. Giá trị lớn nhất
print("\n10. Chiều cao lớn nhất:", np.max(arr_height_m), "m")
print("    Cân nặng lớn nhất:", np.max(arr_weight_kg), "kg")

# 11. Giá trị nhỏ nhất
print("\n11. Chiều cao nhỏ nhất:", np.min(arr_height_m), "m")
print("    Cân nặng nhỏ nhất:", np.min(arr_weight_kg), "kg")
print()

# ===== BÀI 3.6 =====
print("=" * 50)
print("BÀI 3.6: Mảng nhiều chiều")
print("=" * 50)

# 1. arr 3x3 với True
arr = np.full((3, 3), True, dtype=bool)
print("1. arr 3x3 True:")
print(arr)

# 2. arr_2D và đổi cột 1 và 3
arr_ID = np.arange(9)
arr_2D = arr_ID.reshape(3, 3)
print("\n2. arr_2D ban đầu:")
print(arr_2D)
arr_2D[:, [0, 2]] = arr_2D[:, [2, 0]]
print("Sau khi đổi cột 1 và 3:")
print(arr_2D)

# 3. Đổi dòng 1 và 2
arr_2D[[0, 1]] = arr_2D[[1, 0]]
print("\n3. Sau khi đổi dòng 1 và 2:")
print(arr_2D)

# 4. Đảo ngược các dòng
arr_2D = arr_2D[::-1]
print("\n4. Đảo ngược dòng:")
print(arr_2D)

# 5. Đảo ngược các cột
arr_2D = arr_2D[:, ::-1]
print("\n5. Đảo ngược cột:")
print(arr_2D)

# 6. Kiểm tra giá trị NaN - SỬA LỖI Ở ĐÂY: thay np.NaN bằng np.nan
arr_2D_null = np.array([[1, 2, 3], [np.nan, 5, 6], [7, np.nan, 9], [4, 5, 6]])
has_nan = np.isnan(arr_2D_null).any()
print("\n6. Có giá trị NaN không?", has_nan)

# 7. Thay NaN bằng 0
arr_2D_null_filled = np.nan_to_num(arr_2D_null, nan=0)
print("\n7. Thay NaN bằng 0:")
print(arr_2D_null_filled)
print()

# ===== BÀI 3.7 =====
print("=" * 50)
print("BÀI 3.7: Mảng dữ liệu baseball 2D")
print("=" * 50)

# Tạo dữ liệu mẫu baseball (200 cầu thủ)
np.random.seed(456)
baseball_data = []
for _ in range(200):
    height = np.random.randint(160, 200)  # 160-199 cm
    weight = np.random.randint(60, 100)   # 60-99 kg
    baseball_data.append([height, weight])

# 1. Tạo np_baseball
np_baseball = np.array(baseball_data)
print("1. np_baseball - Kiểu dữ liệu:", np_baseball.dtype)
print("   Kích thước:", np_baseball.shape)
print("   5 dòng đầu:")
print(np_baseball[:5])

# 2. Dòng thứ 50
print("\n2. Dòng thứ 50:", np_baseball[49])

# 3. np_weight
np_weight = np_baseball[:, 1]
print("\n3. np_weight (cân nặng) - 5 giá trị đầu:", np_weight[:5])

# 4. Chiều cao cầu thủ 124
print("\n4. Chiều cao cầu thủ 124:", np_baseball[123, 0], "cm")

# 5. Trung bình
print("\n5. Chiều cao trung bình:", np.mean(np_baseball[:, 0]), "cm")
print("   Cân nặng trung bình:", np.mean(np_baseball[:, 1]), "kg")

# 6. Tương quan
correlation = np.corrcoef(np_baseball[:, 0], np_baseball[:, 1])[0, 1]
print("\n6. Hệ số tương quan:", correlation)
if correlation > 0.5:
    print("   => Tương quan thuận mạnh")
elif correlation > 0.3:
    print("   => Tương quan thuận vừa")
elif correlation > 0.1:
    print("   => Tương quan thuận yếu")
elif correlation < -0.5:
    print("   => Tương quan nghịch mạnh")
elif correlation < -0.3:
    print("   => Tương quan nghịch vừa")
elif correlation < -0.1:
    print("   => Tương quan nghịch yếu")
else:
    print("   => Không có tương quan rõ ràng")
print()

# ===== BÀI 3.8 =====
print("=" * 50)
print("BÀI 3.8: Chiều cao theo vị trí (GK, M, A, D)")
print("=" * 50)

# Tạo dữ liệu mẫu với 4 vị trí
np.random.seed(789)
positions_list = []
heights_list = []

# Tạo 50 cầu thủ
for i in range(50):
    # Chọn ngẫu nhiên vị trí
    pos = np.random.choice(['GK', 'M', 'A', 'D'])
    positions_list.append(pos)
    
    # Chiều cao theo vị trí
    if pos == 'GK':
        height = np.random.randint(185, 200)  # Thủ môn cao
    elif pos == 'D':
        height = np.random.randint(180, 195)  # Hậu vệ
    elif pos == 'A':
        height = np.random.randint(175, 190)  # Tiền đạo
    else:  # 'M'
        height = np.random.randint(170, 185)  # Tiền vệ
    
    heights_list.append(height)

# 1. Tạo numpy array
np_positions = np.array(positions_list)
np_heights = np.array(heights_list)

print("1. a) Kiểu np_positions:", np_positions.dtype)
print("   b) Kiểu np_heights:", np_heights.dtype)
print("\n   Phân bố vị trí:")
print("   GK:", np.sum(np_positions == 'GK'), "cầu thủ")
print("   M: ", np.sum(np_positions == 'M'), "cầu thủ")
print("   A: ", np.sum(np_positions == 'A'), "cầu thủ")
print("   D: ", np.sum(np_positions == 'D'), "cầu thủ")

# 2. Chiều cao trung bình GK
gk_mask = np_positions == 'GK'
gk_heights = np_heights[gk_mask]
print("\n2. Chiều cao trung bình GK:", np.mean(gk_heights), "cm")

# 3. Chiều cao trung bình không phải GK
not_gk_mask = np_positions != 'GK'
not_gk_heights = np_heights[not_gk_mask]
print("3. Chiều cao trung bình không phải GK:", np.mean(not_gk_heights), "cm")

# 4. Mảng cấu trúc
players = np.array(list(zip(np_positions, np_heights)),
                   dtype=[('position', 'U5'), ('height', 'float')])
print("\n4. Mảng players (5 dòng đầu):")
for i in range(5):
    print(f"   {players[i]}")

# 5. Sắp xếp theo height
players_sorted = np.sort(players, order='height')
print("\n5. TOP 3 thấp nhất:")
for i in range(3):
    print(f"   {players_sorted[i]}")

print("\n   TOP 3 cao nhất:")
for i in range(1, 4):
    print(f"   {players_sorted[-i]}")

print(f"\n   Chiều cao thấp nhất: {players_sorted[0]}")
print(f"   Chiều cao cao nhất: {players_sorted[-1]}")
print()

# ===== BÀI 3.9 =====
print("=" * 50)
print("BÀI 3.9: Dữ liệu Euro 2012 (Mô phỏng)")
print("=" * 50)

# Tạo dữ liệu mẫu cho Euro 2012
teams = ['Germany', 'Spain', 'Italy', 'England', 'France', 'Portugal', 
         'Greece', 'Sweden', 'Russia', 'Ukraine']
goals = [10, 12, 6, 5, 3, 8, 5, 5, 5, 2]
yellow_cards = [4, 5, 6, 3, 2, 7, 9, 4, 6, 5]
red_cards = [0, 0, 1, 0, 1, 0, 0, 0, 1, 0]

print("1. Cột Goals:")
for i, team in enumerate(teams):
    print(f"   {team}: {goals[i]}")

print("\n2. Số đội tham gia Euro2012:", len(teams))

print("\n3. Thông tin Euro2012:")
print(f"   - Số đội: {len(teams)}")
print(f"   - Tổng số bàn: {sum(goals)}")
print(f"   - Trung bình bàn/đội: {sum(goals)/len(goals):.2f}")

print("\n4. DataFrame discipline (Team, Yellow Cards, Red Cards):")
print("   " + "-" * 40)
for i in range(len(teams)):
    print(f"   {teams[i]:10} | Yellow: {yellow_cards[i]:2} | Red: {red_cards[i]}")

print("\n5. Sắp xếp giảm dần theo Red Cards, Yellow Cards:")
# Tạo danh sách và sắp xếp
team_data = list(zip(teams, yellow_cards, red_cards))
sorted_data = sorted(team_data, key=lambda x: (x[2], x[1]), reverse=True)
for team, yc, rc in sorted_data:
    print(f"   {team:10} | Red: {rc} | Yellow: {yc}")

print(f"\n6. a) Trung bình Yellow Cards: {sum(yellow_cards)/len(yellow_cards):.2f}")

print("\n   b) Các đội ghi hơn 6 bàn thắng:")
for i in range(len(teams)):
    if goals[i] > 6:
        print(f"   - {teams[i]}: {goals[i]} bàn")

print("\n7. Các đội tên bắt đầu bằng 'G':")
for team in teams:
    if team.startswith('G'):
        print(f"   - {team}")

print("\n8. 7 cột đầu (ở đây là 7 đội đầu):")
for i in range(min(7, len(teams))):
    print(f"   {teams[i]}: Goals={goals[i]}, Yellow={yellow_cards[i]}, Red={red_cards[i]}")

print("\n9. Tất cả cột trừ 3 cột cuối (7 đội đầu):")
for i in range(min(7, len(teams))):
    print(f"   {teams[i]}")

print("\n10. Các cột Team, Goals, Yellow Cards, Red Cards:")
for i in range(len(teams)):
    print(f"   {teams[i]:10} | Goals: {goals[i]:2} | Yellow: {yellow_cards[i]:2} | Red: {red_cards[i]}")

print("\n11. Cột Team, Shooting Accuracy từ England, Italy, Russia:")
# Giả sử có thêm dữ liệu shooting accuracy
shooting_acc = ['80%', '85%', '70%', '75%', '65%', '78%', '72%', '68%', '74%', '60%']
for team in ['England', 'Italy', 'Russia']:
    if team in teams:
        idx = teams.index(team)
        print(f"   {team}: Shooting Accuracy = {shooting_acc[idx]}")

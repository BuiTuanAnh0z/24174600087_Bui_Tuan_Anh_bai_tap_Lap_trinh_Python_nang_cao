# ===== BÀI 4.13 =====
print("\n\nBÀI 4.13: Tìm vị trí")
ser1 = pd.Series([10, 20, 30, 40, 50])
ser2 = pd.Series([20, 40, 60])
positions = []
for val in ser2:
    matches = ser1[ser1 == val]
    if len(matches) > 0:
        positions.append(matches.index[0])

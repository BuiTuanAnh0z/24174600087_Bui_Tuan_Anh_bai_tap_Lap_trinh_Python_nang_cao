# ===== BÀI 4.22 =====
print("\n" + "=" * 60)
print("BÀI 4.22: Dữ liệu chứng khoán")
print("=" * 60)

# Tạo dữ liệu mẫu
np.random.seed(42)
dates = pd.date_range('2023-01-01', periods=5, freq='D')
symbols = ['AAPL', 'GOOGL', 'MSFT']

# Tạo stocks1
stocks1_data = []
for date in dates:
    for symbol in symbols:
        open_price = round(np.random.uniform(100, 200), 2)
        high = round(open_price * np.random.uniform(1.01, 1.05), 2)
        low = round(open_price * np.random.uniform(0.95, 0.99), 2)
        close = round(np.random.uniform(low, high), 2)
        volume = np.random.randint(1000000, 5000000)
        
        stocks1_data.append([date, symbol, open_price, high, low, close, volume])

stocks1 = pd.DataFrame(stocks1_data, 
                      columns=['date', 'symbol', 'open', 'high', 'low', 'close', 'volume'])

print("1. a) stocks1 - 5 dòng đầu:")
print(stocks1.head())
print(f"\nShape: {stocks1.shape}")
print("\nKiểu dữ liệu:")
print(stocks1.dtypes)

# Tạo stocks2
dates2 = pd.date_range('2023-01-06', periods=3, freq='D')
stocks2_data = []
for date in dates2:
    for symbol in symbols:
        open_price = round(np.random.uniform(100, 200), 2)
        high = round(open_price * np.random.uniform(1.01, 1.05), 2)
        low = round(open_price * np.random.uniform(0.95, 0.99), 2)
        close = round(np.random.uniform(low, high), 2)
        volume = np.random.randint(1000000, 5000000)
        
        stocks2_data.append([date, symbol, open_price, high, low, close, volume])

stocks2 = pd.DataFrame(stocks2_data, 
                      columns=['date', 'symbol', 'open', 'high', 'low', 'close', 'volume'])

print("\n1. b) stocks2 - 3 dòng đầu:")
print(stocks2.head())

# Tạo companies
companies_data = [
    ['Apple Inc.', 164000, 'Cupertino', 'California', 'AAPL'],
    ['Alphabet Inc.', 190234, 'Mountain View', 'California', 'GOOGL'],
    ['Microsoft', 221000, 'Redmond', 'Washington', 'MSFT']
]

companies = pd.DataFrame(companies_data, 
                        columns=['name', 'employees', 'headquarters_city', 
                                'headquarters_state', 'symbol'])

print("\n1. c) companies:")
print(companies)

# 2. Kiểm tra null
print("\n2. Kiểm tra null trong stocks1:")
print("Số null mỗi cột:")
print(stocks1.isnull().sum())

# Thêm null để demo
stocks1.loc[0, 'high'] = np.nan
stocks1.loc[3, 'low'] = np.nan
print("\nSau khi thêm null demo:")
print(stocks1.isnull().sum())

# Xử lý null
for symbol in symbols:
    mask = stocks1['symbol'] == symbol
    
    # Thay null high bằng max high của mã đó
    if stocks1.loc[mask, 'high'].isnull().any():
        high_max = stocks1.loc[mask, 'high'].max(skipna=True)
        stocks1.loc[mask & stocks1['high'].isnull(), 'high'] = high_max
    
    # Thay null low bằng min low của mã đó
    if stocks1.loc[mask, 'low'].isnull().any():
        low_min = stocks1.loc[mask, 'low'].min(skipna=True)
        stocks1.loc[mask & stocks1['low'].isnull(), 'low'] = low_min

print("\nSau khi xử lý null:")
print(stocks1.isnull().sum())

# 3. Gộp stocks1 và stocks2
stocks = pd.concat([stocks1, stocks2], ignore_index=True)
print(f"\n3. Gộp stocks1 và stocks2 -> shape: {stocks.shape}")
print("5 dòng cuối:")
print(stocks.tail())

# 4. Gộp stocks và companies
stocks_companies = pd.merge(stocks, companies, on='symbol', how='left')
print(f"\n4. Gộp stocks và companies -> shape: {stocks_companies.shape}")
print("5 dòng đầu:")
print(stocks_companies.head())

# 5. Giá trung bình mỗi công ty
print("\n5. Giá trung bình mỗi công ty:")
avg_prices = stocks_companies.groupby('name')[['open', 'high', 'low', 'close']].mean().round(2)
print(avg_prices)

# 6. Thống kê giá đóng cửa
print("\n6. Thống kê giá đóng cửa:")
close_stats = stocks_companies.groupby('name')['close'].agg(['mean', 'max', 'min']).round(2)
print(close_stats)

# 7. Chuyển đổi datetime
stocks_companies['parsed_time'] = pd.to_datetime(stocks_companies['date'])
print("\n7. Cột parsed_time - kiểu:", stocks_companies['parsed_time'].dtype)
print("3 dòng đầu với parsed_time:")
print(stocks_companies[['date', 'parsed_time', 'symbol', 'open', 'close']].head(3))

# 8. Thêm cột result
stocks_companies['result'] = np.where(
    stocks_companies['close'] > stocks_companies['open'], 
    'up', 
    'down'
)
print("\n8. Thêm cột result:")
print(stocks_companies[['date', 'symbol', 'open', 'close', 'result']].head())

# ===== BÀI 4.23 =====
print("\n" + "=" * 60)
print("BÀI 4.23: Dữ liệu MovieLens")
print("=" * 60)

# Tạo dữ liệu mẫu movies
movies_data = {
    'movieId': [1, 2, 3, 4, 5],
    'title': ['Toy Story (1995)', 
              'Jumanji (1995)', 
              'Grumpier Old Men (1995)', 
              'Waiting to Exhale (1995)', 
              'Father of the Bride Part II (1995)'],
    'genres': ['Adventure|Animation|Children|Comedy|Fantasy',
               'Adventure|Children|Fantasy',
               'Comedy|Romance',
               'Comedy|Drama|Romance',
               'Comedy']
}

movies = pd.DataFrame(movies_data)
print("1. Dữ liệu movies:")
print(movies)

# Tạo dữ liệu ratings
np.random.seed(123)
n_ratings = 20
ratings_data = []
for i in range(n_ratings):
    userId = np.random.randint(1, 6)
    movieId = np.random.randint(1, 6)
    rating = np.random.randint(1, 6)
    timestamp = 1704067200 + i * 86400  # Unix timestamp
    ratings_data.append([userId, movieId, rating, timestamp])

ratings = pd.DataFrame(ratings_data, 
                      columns=['userId', 'movieId', 'rating', 'timestamp'])

print("\n2. Dữ liệu ratings (5 dòng đầu):")
print(ratings.head())

# Kiểm tra dữ liệu thiếu
print("\n3. Kiểm tra dữ liệu thiếu:")
print("movies có null:", movies.isnull().sum().sum())
print("ratings có null:", ratings.isnull().sum().sum())

# Gộp dữ liệu
merged = pd.merge(ratings, movies, on='movieId')
print(f"\n4. Gộp ratings và movies -> shape: {merged.shape}")
print("5 dòng đầu merged:")
print(merged.head())

# Thống kê cơ bản
print("\n5. Thống kê rating:")
print(f"Số lượng đánh giá: {len(merged)}")
print(f"Trung bình rating: {merged['rating'].mean():.2f}")
print("Phân phối rating:")
print(merged['rating'].value_counts().sort_index())

# Phân tích theo thể loại
# Tách genres
genres_expanded = merged.copy()
genres_expanded['genres'] = genres_expanded['genres'].str.split('|')
genres_expanded = genres_expanded.explode('genres')

print("\n6. Đánh giá trung bình theo thể loại:")
genre_stats = genres_expanded.groupby('genres')['rating'].agg(['mean', 'count']).round(2)
print(genre_stats.sort_values('mean', ascending=False))

# Phân tích theo thời gian
print("\n7. Phân tích theo thời gian:")
merged['datetime'] = pd.to_datetime(merged['timestamp'], unit='s')
merged['year'] = merged['datetime'].dt.year
merged['month'] = merged['datetime'].dt.month

print("Số đánh giá theo phim:")
movie_counts = merged['title'].value_counts()
print(movie_counts.head())

# Top phim được đánh giá cao
print("\n8. Phim có rating trung bình cao nhất (ít nhất 2 đánh giá):")
movie_avg = merged.groupby('title')['rating'].agg(['mean', 'count'])
top_movies = movie_avg[movie_avg['count'] >= 2].sort_values('mean', ascending=False).head(3)
print(top_movies)

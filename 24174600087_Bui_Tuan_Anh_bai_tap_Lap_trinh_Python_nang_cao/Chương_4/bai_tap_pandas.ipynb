import pandas as pd
import numpy as np


# ===== BÀI 4.1 =====
print("\nBÀI 4.1: Tạo Series")
mylist = list('abcedfghijklmnopqrstuvwxyz')
myarr = np.arange(26)
mydict = dict(zip(mylist, myarr))

ser1 = pd.Series(mylist)
ser2 = pd.Series(myarr)
ser3 = pd.Series(mydict)

print("Series từ list (3 phần tử):", ser1.head(3).tolist())
print("Series từ array (3 phần tử):", ser2.head(3).tolist())
print("Series từ dict (3 phần tử):", dict(list(ser3.head(3).items())))

# ===== BÀI 4.2 =====
print("\n\nBÀI 4.2: Series -> DataFrame")
ser = pd.Series(mydict)
df = ser.reset_index()
df.columns = ['key', 'value']
print("DataFrame từ Series (5 dòng đầu):")
print(df.head())

# ===== BÀI 4.3 =====
print("\n\nBÀI 4.3: Kết nối Series")
ser1 = pd.Series(list('abcde'))

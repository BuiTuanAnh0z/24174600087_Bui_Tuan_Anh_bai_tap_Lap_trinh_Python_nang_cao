print("ser2:", list(ser2))
print("Vị trí của ser2 trong ser1:", positions)

# ===== BÀI 4.14 =====
print("\n\nBÀI 4.14: Tính MSE")
truth = pd.Series([1, 2, 3, 4, 5])
pred = pd.Series([1.1, 1.9, 3.2, 3.8, 5.1])
mse = ((truth - pred) ** 2).mean()
rmse = mse ** 0.5
print("Truth:", list(truth))
print("Pred:", [round(x, 2) for x in pred])
print(f"MSE: {mse:.4f}")
print(f"RMSE: {rmse:.4f}")


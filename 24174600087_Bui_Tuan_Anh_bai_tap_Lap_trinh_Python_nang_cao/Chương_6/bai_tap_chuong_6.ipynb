# URLs để test HTTP requests
test_urls = [
    "https://httpbin.org/get",
    "https://httpbin.org/post",
    "https://httpbin.org/status/200",
    "https://httpbin.org/status/404",
    "https://httpbin.org/delay/1"  # URL có delay 1 giây
]

http_results = {}
http_lock = threading.Lock()

def make_http_request(url, request_id):
    """Thực hiện HTTP request"""
    print(f"Request {request_id}: Đang gửi đến {url}")
    
    try:
        if "post" in url:
            response = requests.post(url, json={"test": "data"}, timeout=10)
        elif "delay" in url:
            response = requests.get(url, timeout=15)
        else:
            response = requests.get(url, timeout=10)
        
        with http_lock:
            http_results[request_id] = {
                'url': url,
                'status_code': response.status_code,
                'response_time': response.elapsed.total_seconds()
            }
        
        print(f"Request {request_id}: Hoàn thành - Status {response.status_code} "
              f"(Thời gian: {response.elapsed.total_seconds():.2f}s)")
        
    except Exception as e:
        with http_lock:
            http_results[request_id] = {
                'url': url,
                'error': str(e)
            }
        print(f"Request {request_id}: Lỗi - {e}")

# Tạo và chạy luồng cho mỗi request
http_threads = []
for i, url in enumerate(test_urls[:3]):  # Chỉ dùng 3 URL để demo
    thread = threading.Thread(target=make_http_request, args=(url, i+1))
    http_threads.append(thread)
    thread.start()
    time.sleep(0.1)  # Delay nhỏ giữa các request

# Đợi tất cả luồng hoàn thành
for thread in http_threads:
    thread.join()

print("\nKết quả HTTP requests:")
for req_id, result in sorted(http_results.items()):
    if 'error' in result:
        print(f"Request {req_id}: {result['url']} - LỖI: {result['error']}")
    else:
        print(f"Request {req_id}: {result['url']} - Status: {result['status_code']}, "
              f"Thời gian: {result['response_time']:.2f}s")


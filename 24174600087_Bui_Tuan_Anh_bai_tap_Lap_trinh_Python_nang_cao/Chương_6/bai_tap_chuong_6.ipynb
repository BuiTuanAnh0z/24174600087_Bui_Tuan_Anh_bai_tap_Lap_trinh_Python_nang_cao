# ===== DEMO THÊM: ThreadPool =====
print("\n" + "=" * 60)
print("DEMO THÊM: Sử dụng ThreadPool")
print("=" * 60)

from concurrent.futures import ThreadPoolExecutor, as_completed

def process_item(item):
    """Xử lý một item"""
    time.sleep(random.uniform(0.1, 0.5))
    return item * 2

# Tạo list dữ liệu
data = list(range(1, 11))

print(f"Dữ liệu gốc: {data}")

# Sử dụng ThreadPoolExecutor
with ThreadPoolExecutor(max_workers=3) as executor:
    # Gửi các task đến thread pool
    future_to_item = {executor.submit(process_item, item): item for item in data}
    
    results = []
    for future in as_completed(future_to_item):
        item = future_to_item[future]
        try:
            result = future.result()
            results.append(result)
            print(f"Xử lý {item} -> {result}")
        except Exception as e:
            print(f"Lỗi xử lý {item}: {e}")

print(f"\nKết quả sau xử lý: {sorted(results)}")

print("\n" + "=" * 60)
print("HOÀN THÀNH TẤT CẢ BÀI TẬP MULTITHREADING")
print("=" * 60)

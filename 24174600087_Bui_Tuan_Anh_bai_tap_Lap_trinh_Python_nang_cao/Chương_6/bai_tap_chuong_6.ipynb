def print_thread_name(thread_num):
    """Hàm in tên luồng"""
    print(f"Luồng {thread_num}: Tên = {threading.current_thread().name}")
    time.sleep(0.5)

# Tạo và chạy 5 luồng
threads = []
for i in range(1, 6):
    thread = threading.Thread(target=print_thread_name, args=(i,), name=f"Thread-{i}")
    threads.append(thread)
    thread.start()

# Đợi tất cả luồng hoàn thành
for thread in threads:
    thread.join()


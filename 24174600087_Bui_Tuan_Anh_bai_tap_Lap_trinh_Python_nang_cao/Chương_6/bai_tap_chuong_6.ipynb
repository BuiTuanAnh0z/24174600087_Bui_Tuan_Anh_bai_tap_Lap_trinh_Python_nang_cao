for i, url in enumerate(sample_urls[:2]):  # Chỉ tải 2 file để demo
    file_name = f"file_{i+1}.bin"
    thread = threading.Thread(target=download_file, args=(url, file_name))
    download_threads.append(thread)
    thread.start()


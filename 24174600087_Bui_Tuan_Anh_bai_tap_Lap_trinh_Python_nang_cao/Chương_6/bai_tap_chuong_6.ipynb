def download_file(url, file_name):
    """Hàm tải file từ URL"""
    print(f"Bắt đầu tải: {file_name}")
    try:
        response = requests.get(url, timeout=5)
        if response.status_code == 200:
            # Trong thực tế, bạn sẽ lưu file xuống đĩa
            # with open(file_name, 'wb') as f:
            #     f.write(response.content)
            time.sleep(random.uniform(0.5, 1.5))  # Giả lập thời gian tải
            print(f"Hoàn thành tải: {file_name} ({len(response.content)} bytes)")
        else:
            print(f"Lỗi tải {file_name}: Status code {response.status_code}")
    except Exception as e:
        print(f"Lỗi tải {file_name}: {e}")

# Tạo luồng cho mỗi URL

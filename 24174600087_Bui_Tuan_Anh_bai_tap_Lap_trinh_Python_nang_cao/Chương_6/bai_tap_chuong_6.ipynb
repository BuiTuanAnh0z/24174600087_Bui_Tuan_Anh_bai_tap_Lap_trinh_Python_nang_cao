print("=" * 60)

results = {}
results_lock = threading.Lock()

def calculate_factorial(number):
    """Tính giai thừa của một số"""
    result = 1
    for i in range(1, number + 1):
        result *= i
        time.sleep(0.01)  # Thêm độ trễ
    
    with results_lock:
        results[number] = result
    print(f"Giai thừa của {number}! = {result}")

# Các số cần tính giai thừa
numbers_to_calculate = [5, 7, 10, 12, 15]

# Tạo và chạy luồng cho mỗi số
factorial_threads = []
for num in numbers_to_calculate:
    thread = threading.Thread(target=calculate_factorial, args=(num,))
    factorial_threads.append(thread)
    thread.start()

# Đợi tất cả luồng hoàn thành
for thread in factorial_threads:
    thread.join()

print("\nKết quả giai thừa đầy đủ:")
for num, fact in sorted(results.items()):
    print(f"{num}! = {fact}")


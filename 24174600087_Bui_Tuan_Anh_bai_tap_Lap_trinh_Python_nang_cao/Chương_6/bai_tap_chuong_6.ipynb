    with max_lock:
        partial_maxes.append(partial_max)
    
    print(f"Luồng {thread_id}: Max trong sublist = {partial_max} "
          f"(số phần tử: {len(sublist)})")

# Chia list thành các phần nhỏ
num_threads_2 = 5

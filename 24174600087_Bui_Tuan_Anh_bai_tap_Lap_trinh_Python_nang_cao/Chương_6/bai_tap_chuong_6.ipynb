def website_worker(website_name, access_count=4):
    """Worker mô phỏng truy cập website"""
    print(f"Starting {website_name}")
    
    for i in range(1, access_count + 1):
        current_time = time.strftime("%a %b %d %H:%M:%S %Y", time.localtime())
        print(f"{website_name}: Web {current_time}")
        
        # Tạo độ trễ ngẫu nhiên giữa các lần truy cập
        delay = random.uniform(1.0, 3.0)
        time.sleep(delay)
    
    print(f"Exiting {website_name}")

print("Starting Main Thread")

# Tạo luồng cho các website
google_thread = threading.Thread(target=website_worker, args=("Google", 4))
yahoo_thread = threading.Thread(target=website_worker, args=("Yahoo", 4))
facebook_thread = threading.Thread(target=website_worker, args=("Facebook", 4))

# Bắt đầu các luồng

print("=" * 60)

# Tạo list ngẫu nhiên
list_size = 100
random_list = [random.randint(0, 10) for _ in range(list_size)]

print(f"List có {list_size} phần tử ngẫu nhiên từ 0-10")
print(f"10 phần tử đầu: {random_list[:10]}")

# Biến chia sẻ cho kết quả
partial_sums = []
sum_lock = threading.Lock()

def calculate_partial_sum(sublist, thread_id):
    """Tính tổng của một sublist"""
    partial_sum = sum(sublist)
    
    with sum_lock:
        partial_sums.append(partial_sum)
    
    print(f"Luồng {thread_id}: Tổng sublist = {partial_sum} (số phần tử: {len(sublist)})")

# Chia list thành các phần nhỏ
num_threads = 4
chunk_size = len(random_list) // num_threads
threads_list = []

print(f"\nChia list thành {num_threads} phần, mỗi phần ~{chunk_size} phần tử")

# Tạo và chạy luồng cho mỗi phần
for i in range(num_threads):
    start_idx = i * chunk_size
    end_idx = start_idx + chunk_size if i < num_threads - 1 else len(random_list)
    sublist = random_list[start_idx:end_idx]
    
    thread = threading.Thread(target=calculate_partial_sum, args=(sublist, i+1))
    threads_list.append(thread)
    thread.start()

# Đợi tất cả luồng hoàn thành
for thread in threads_list:
    thread.join()

# Tính tổng cuối cùng
total_sum = sum(partial_sums)
actual_sum = sum(random_list)

print(f"\nKết quả tính tổng bằng {num_threads} luồng:")
print(f"Tổng các phần: {partial_sums}")
print(f"Tổng cuối cùng (từ các luồng): {total_sum}")
print(f"Tổng thực tế (tính trực tiếp): {actual_sum}")
print(f"Hai kết quả khớp: {total_sum == actual_sum}")


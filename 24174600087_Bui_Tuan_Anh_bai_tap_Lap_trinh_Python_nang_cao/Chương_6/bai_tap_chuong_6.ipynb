# Biến chia sẻ
numbers = list(range(30, 51))
even_numbers = []
odd_numbers = []
lock = threading.Lock()

def find_even_numbers(num_list, result_list):
    """Tìm số chẵn"""
    for num in num_list:
        if num % 2 == 0:
            with lock:
                result_list.append(num)
            time.sleep(0.05)  # Thêm độ trễ để thấy rõ multithreading

def find_odd_numbers(num_list, result_list):
    """Tìm số lẻ"""
    for num in num_list:
        if num % 2 == 1:
            with lock:
                result_list.append(num)
            time.sleep(0.05)

# Chia danh sách số thành 2 phần
mid = len(numbers) // 2
first_half = numbers[:mid]
second_half = numbers[mid:]

# Tạo và chạy luồng
even_thread1 = threading.Thread(target=find_even_numbers, args=(first_half, even_numbers))
even_thread2 = threading.Thread(target=find_even_numbers, args=(second_half, even_numbers))
odd_thread1 = threading.Thread(target=find_odd_numbers, args=(first_half, odd_numbers))
odd_thread2 = threading.Thread(target=find_odd_numbers, args=(second_half, odd_numbers))

print("Bắt đầu tìm số chẵn và lẻ...")

# Bắt đầu các luồng

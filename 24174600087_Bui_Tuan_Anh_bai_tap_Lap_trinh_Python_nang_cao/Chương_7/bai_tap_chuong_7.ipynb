#Bài 7.8b
import tkinter as tk
from tkinter import ttk, messagebox
import math

class DivisorsApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Bài 7.8b - Tìm Ước Số (GUI)")
        self.root.geometry("600x500")
        
        self.create_widgets()
    
    def create_widgets(self):
        # Tiêu đề
        title_label = tk.Label(
            self.root,
            text="CHƯƠNG TRÌNH TÌM ƯỚC SỐ",
            font=("Arial", 16, "bold"),
            fg="darkblue"
        )
        title_label.pack(pady=15)
        
        # Khung nhập liệu
        input_frame = tk.Frame(self.root)
        input_frame.pack(pady=10)
        
        tk.Label(
            input_frame,
            text="Nhập số nguyên N:",
            font=("Arial", 12)
        ).pack(side=tk.LEFT, padx=5)
        
        self.entry_n = tk.Entry(
            input_frame,
            width=20,
            font=("Arial", 12)
        )
        self.entry_n.pack(side=tk.LEFT, padx=5)
        
        # Nút tìm ước
        find_button = tk.Button(
            self.root,
            text="TÌM ƯỚC SỐ",
            command=self.find_divisors,
            bg="blue",
            fg="white",
            font=("Arial", 11, "bold"),
            width=15
        )
        find_button.pack(pady=10)
        
        # Khung kết quả
        result_frame = tk.LabelFrame(
            self.root,
            text="KẾT QUẢ",
            font=("Arial", 11, "bold"),
            padx=10,
            pady=10
        )
        result_frame.pack(pady=10, padx=20, fill=tk.BOTH, expand=True)
        
        # Text widget để hiển thị kết quả
        self.result_text = tk.Text(
            result_frame,
            height=15,
            width=60,
            font=("Consolas", 10),
            wrap=tk.WORD
        )
        self.result_text.pack(fill=tk.BOTH, expand=True)
        
        # Thêm scrollbar
        scrollbar = tk.Scrollbar(self.result_text)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        self.result_text.config(yscrollcommand=scrollbar.set)
        scrollbar.config(command=self.result_text.yview)
        
        # Khung thống kê
        stats_frame = tk.Frame(self.root)
        stats_frame.pack(pady=10)
        
        self.stats_label = tk.Label(
            stats_frame,
            text="",
            font=("Arial", 10),
            fg="darkgreen"
        )
        self.stats_label.pack()
    
    def find_divisors(self):
        """Tìm và hiển thị các ước số"""
        try:
            # Lấy giá trị từ ô nhập
            n_str = self.entry_n.get().strip()
            
            if not n_str:
                messagebox.showwarning("Thiếu dữ liệu", "Vui lòng nhập số N!")
                return
            
            N = int(n_str)
            
            # Xóa kết quả cũ
            self.result_text.delete(1.0, tk.END)
            self.stats_label.config(text="")
            
            if N == 0:
                self.result_text.insert(1.0, "Số 0 có vô số ước (mọi số nguyên khác 0)")
                return
            
            # Xử lý số âm
            is_negative = N < 0
            if is_negative:
                N = abs(N)
                self.result_text.insert(1.0, f"Đang xử lý giá trị tuyệt đối |{n_str}| = {N}\n\n")
            
            # Tìm các ước số
            divisors = []
            
            # Phương pháp tối ưu
            for i in range(1, int(math.sqrt(N)) + 1):
                if N % i == 0:
                    divisors.append(i)
                    if i != N // i:  # Tránh trùng lặp
                        divisors.append(N // i)
            
            # Sắp xếp
            divisors.sort()
            
            # Hiển thị kết quả
            self.result_text.insert(tk.END, f"Các ước của {N if not is_negative else f'|{n_str}|'}:\n")
            self.result_text.insert(tk.END, "=" * 40 + "\n\n")
            
            # Hiển thị theo định dạng đẹp
            for i, divisor in enumerate(divisors, 1):
                self.result_text.insert(tk.END, f"{divisor:8}")
                if i % 8 == 0:  # 8 số mỗi dòng
                    self.result_text.insert(tk.END, "\n")
            
            if len(divisors) % 8 != 0:
                self.result_text.insert(tk.END, "\n")
            
            self.result_text.insert(tk.END, "\n" + "=" * 40 + "\n")
            
            # Thống kê
            total_divisors = len(divisors)
            smallest = min(divisors)
            largest = max(divisors)
            
            stats_text = f"• Tổng số ước: {total_divisors}\n"
            stats_text += f"• Ước nhỏ nhất: {smallest}\n"
            stats_text += f"• Ước lớn nhất: {largest}\n"
            
            # Kiểm tra số nguyên tố
            if total_divisors == 2:
                stats_text += f"• {N} là số NGUYÊN TỐ\n"
            else:
                stats_text += f"• {N} KHÔNG phải số nguyên tố\n"
            
            # Hiển thị các cặp ước
            self.result_text.insert(tk.END, "\nCác cặp ước nhân với nhau bằng N:\n")
            for i in range(len(divisors)//2):
                j = len(divisors) - 1 - i
                if i < j:
                    self.result_text.insert(tk.END, f"  {divisors[i]} × {divisors[j]} = {N}\n")
            
            # Cập nhật thống kê
            self.stats_label.config(text=stats_text)
            
        except ValueError:
            messagebox.showerror("Lỗi", "Vui lòng nhập một số nguyên hợp lệ!")
        except Exception as e:
            messagebox.showerror("Lỗi", f"Có lỗi xảy ra: {str(e)}")

# Chương trình chính
if __name__ == "__main__":
    root = tk.Tk()
    app = DivisorsApp(root)
    root.mainloop()


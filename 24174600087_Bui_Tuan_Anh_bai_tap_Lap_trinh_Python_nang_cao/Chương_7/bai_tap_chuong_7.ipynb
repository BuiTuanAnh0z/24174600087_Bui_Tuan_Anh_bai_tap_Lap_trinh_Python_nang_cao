#Bài 7.8a
def list_divisors_console():
    """
    Viết chương trình liệt kê tất cả các ước của một số nguyên N
    với N nhập từ bàn phím (phiên bản console)
    """
    print("=" * 40)
    print("CHƯƠNG TRÌNH LIỆT KÊ ƯỚC SỐ")
    print("=" * 40)
    
    try:
        # Nhập số nguyên N từ bàn phím
        N = int(input("Nhập số nguyên N: "))
        
        if N <= 0:
            print("Vui lòng nhập số nguyên dương!")
            return
        
        print(f"\nCác ước của {N} là:")
        
        # Danh sách các ước số
        divisors = []
        
        # Tìm các ước số
        for i in range(1, N + 1):
            if N % i == 0:
                divisors.append(i)
        
        # Hiển thị kết quả
        # Hiển thị theo hàng ngang
        for i, divisor in enumerate(divisors, 1):
            print(f"{divisor:5}", end="")
            if i % 10 == 0:  # Xuống dòng sau mỗi 10 số
                print()
        
        if len(divisors) % 10 != 0:
            print()  # Xuống dòng nếu chưa xuống
        
        # Thông tin thêm
        print(f"\n• Tổng số ước: {len(divisors)}")
        print(f"• Ước nhỏ nhất: {min(divisors)}")
        print(f"• Ước lớn nhất: {max(divisors)}")
        
        # Kiểm tra số nguyên tố
        if len(divisors) == 2:
            print(f"• {N} là số NGUYÊN TỐ")
        else:
            print(f"• {N} KHÔNG phải số nguyên tố")
        
        # Hiển thị các ước theo cặp nhân
        print(f"\nCác cặp ước nhân với nhau bằng {N}:")
        for i in range(len(divisors)//2 + 1):
            j = len(divisors) - 1 - i
            if i < j:
                print(f"  {divisors[i]} × {divisors[j]} = {N}")
        
    except ValueError:
        print("Lỗi: Vui lòng nhập một số nguyên hợp lệ!")

def list_divisors_advanced():
    """
    Phiên bản nâng cao với nhiều tính năng hơn
    """
    print("=" * 50)
    print("CHƯƠNG TRÌNH LIỆT KÊ ƯỚC SỐ (NÂNG CAO)")
    print("=" * 50)
    
    try:
        N = int(input("Nhập số nguyên N: "))
        
        if N == 0:
            print("Số 0 có vô số ước (mọi số nguyên khác 0)")
            return
        elif N < 0:
            print(f"Đang xử lý giá trị tuyệt đối |{N}| = {abs(N)}")
            N = abs(N)
        
        print(f"\nPHÂN TÍCH SỐ {N}")
        print("-" * 30)
        
        # Tìm các ước số
        divisors = []
        prime_divisors = []  # Các ước nguyên tố
        
        # Phương pháp tối ưu: chỉ cần kiểm tra đến sqrt(N)
        import math
        sqrt_n = int(math.sqrt(N))
        
        print("Quá trình tìm ước:")
        for i in range(1, sqrt_n + 1):
            if N % i == 0:
                divisors.append(i)
                if i != N // i:  # Tránh trùng lặp khi i = N//i
                    divisors.append(N // i)
                
                # Kiểm tra ước nguyên tố
                if i > 1:
                    # Kiểm tra i có phải nguyên tố không
                    is_prime = True
                    for j in range(2, int(math.sqrt(i)) + 1):
                        if i % j == 0:
                            is_prime = False
                            break
                    if is_prime and i not in prime_divisors:
                        prime_divisors.append(i)
        
        # Sắp xếp các ước theo thứ tự tăng dần
        divisors.sort()
        
        # Hiển thị kết quả
        print(f"\nTất cả các ước của {N} ({len(divisors)} ước):")
        
        # Hiển thị thành bảng
        col_width = 8
        cols = 8  # Số cột muốn hiển thị
        
        for i, divisor in enumerate(divisors):
            print(f"{divisor:>{col_width}}", end="")
            if (i + 1) % cols == 0:
                print()
        
        if len(divisors) % cols != 0:
            print()
        
        # Thống kê
        print(f"\nTHỐNG KÊ:")
        print(f"  • Tổng số ước: {len(divisors)}")
        
        if prime_divisors:
            print(f"  • Các ước nguyên tố: {', '.join(map(str, prime_divisors))}")
        
        # Tính tổng các ước
        sum_divisors = sum(divisors)
        print(f"  • Tổng các ước: {sum_divisors}")
        
        # Số hoàn hảo (nếu tổng các ước (trừ chính nó) bằng n)
        if sum(divisors[:-1]) == N:
            print(f"  • {N} là SỐ HOÀN HẢO!")
        elif sum(divisors[:-1]) > N:
            print(f"  • {N} là số DỒI DÀO (abundant)")
        else:
            print(f"  • {N} là số KHIẾM (deficient)")
        
    except ValueError:
        print("✗ Lỗi: Vui lòng nhập một số nguyên hợp lệ!")

def run_menu():
    """Chạy menu chương trình"""
    while True:
        print("\n" + "=" * 50)
        print("MENU CHƯƠNG TRÌNH ƯỚC SỐ")
        print("=" * 50)
        print("1. Phiên bản cơ bản")
        print("2. Phiên bản nâng cao")
        print("3. Thoát")
        print("-" * 50)
        
        choice = input("Chọn chức năng (1-3): ").strip()
        
        if choice == "1":
            list_divisors_console()
        elif choice == "2":
            list_divisors_advanced()
        elif choice == "3":
            print("Cảm ơn bạn đã sử dụng chương trình!")
            break
        else:
            print("Lựa chọn không hợp lệ. Vui lòng chọn lại!")
        
        input("\nNhấn Enter để tiếp tục...")

# Phiên bản đơn giản nhất để chạy nhanh
def simple_version():
    """Phiên bản đơn giản nhất theo yêu cầu"""
    print("CHƯƠNG TRÌNH LIỆT KÊ ƯỚC SỐ")
    print("=" * 30)
    
    try:
        N = int(input("Nhập số nguyên N: "))
        
        if N == 0:
            print("Số 0 có vô số ước")
            return
        
        # Chuyển sang số dương nếu cần
        if N < 0:
            N = abs(N)
            print(f"Đang xử lý |N| = {N}")
        
        print(f"\nCác ước của {N} là:")
        
        divisors = []
        count = 0
        
        for i in range(1, N + 1):
            if N % i == 0:
                divisors.append(i)
                count += 1
                print(f"{i:6}", end="")
                if count % 8 == 0:
                    print()
        
        if count % 8 != 0:
            print()
        
        print(f"\nTổng cộng: {count} ước số")
        
    except ValueError:
        print("Vui lòng nhập một số nguyên!")


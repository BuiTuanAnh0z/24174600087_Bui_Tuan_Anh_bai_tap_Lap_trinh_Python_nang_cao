#Bài 7.7
import tkinter as tk
from tkinter import messagebox

class SumCalculatorApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Bài 7.7 - Tính Tổng Dãy Số")
        self.root.geometry("500x350")
        
        self.create_widgets()
    
    def create_widgets(self):
        # Tiêu đề
        title_label = tk.Label(
            self.root,
            text="TÍNH TỔNG DÃY SỐ",
            font=("Arial", 18, "bold"),
            fg="darkblue"
        )
        title_label.pack(pady=20)
        
        # Khung nhập liệu
        input_frame = tk.Frame(self.root)
        input_frame.pack(pady=20)
        
        # Nhãn và ô nhập
        tk.Label(
            input_frame,
            text="Enter value of integer N:",
            font=("Arial", 12)
        ).grid(row=0, column=0, padx=5, pady=10)
        
        self.n_entry = tk.Entry(
            input_frame,
            width=15,
            font=("Arial", 12),
            justify="center"
        )
        self.n_entry.grid(row=0, column=1, padx=5, pady=10)
        
        # Nút Validate (Tính toán)
        validate_button = tk.Button(
            self.root,
            text="Validate",
            command=self.calculate_sum,
            bg="blue",
            fg="white",
            font=("Arial", 12, "bold"),
            width=15,
            height=2
        )
        validate_button.pack(pady=10)
        
        # Khung kết quả
        result_frame = tk.Frame(
            self.root,
            relief=tk.GROOVE,
            bd=2,
            bg="lightyellow"
        )
        result_frame.pack(pady=20, padx=20, fill=tk.BOTH, expand=True)
        
        # Tiêu đề kết quả
        tk.Label(
            result_frame,
            text="KẾT QUẢ",
            font=("Arial", 14, "bold"),
            bg="lightyellow"
        ).pack(pady=10)
        
        # Hiển thị công thức và kết quả
        self.formula_label = tk.Label(
            result_frame,
            text="",
            font=("Arial", 11),
            bg="lightyellow",
            fg="darkgreen"
        )
        self.formula_label.pack(pady=5)
        
        self.result_label = tk.Label(
            result_frame,
            text="",
            font=("Arial", 16, "bold"),
            bg="lightyellow",
            fg="red"
        )
        self.result_label.pack(pady=10)
        
        # Chú thích
        tk.Label(
            result_frame,
            text="Công thức: 1 + 2 + 3 + ... + N = N*(N+1)/2",
            font=("Arial", 9, "italic"),
            bg="lightyellow",
            fg="gray"
        ).pack(pady=5)
    
    def calculate_sum(self):
        """Tính tổng từ 1 đến N"""
        try:
            # Lấy giá trị N
            n_str = self.n_entry.get().strip()
            
            if not n_str:
                messagebox.showwarning("Thiếu dữ liệu", "Vui lòng nhập giá trị N!")
                return
            
            N = int(n_str)
            
            # Kiểm tra giá trị hợp lệ
            if N <= 0:
                messagebox.showwarning("Cảnh báo", "N phải là số nguyên dương!")
                return
            elif N > 1000:
                if not messagebox.askyesno("Xác nhận", f"N = {N} rất lớn. Bạn có chắc muốn tiếp tục?"):
                    return
            
            # Tính tổng
            # Cách 1: Dùng vòng lặp
            total = 0
            for i in range(1, N + 1):
                total += i
            
            # Cách 2: Dùng công thức (nhanh hơn)
            # total = N * (N + 1) // 2
            
            # Tạo chuỗi công thức
            if N <= 10:  # Hiển thị đầy đủ nếu N nhỏ
                numbers = " + ".join(str(i) for i in range(1, N + 1))
                formula_text = f"1 + 2 + 3 + ... + {N} = {numbers}"
            else:  # Rút gọn nếu N lớn
                formula_text = f"1 + 2 + 3 + ... + {N}"
            
            # Hiển thị kết quả
            self.formula_label.config(text=formula_text)
            self.result_label.config(text=f"The sum is = {total:,}")
            
            # Thêm hiệu ứng
            self.result_label.config(fg="darkred")
            
            # Lưu lịch sử
            self.save_history(N, total)
            
        except ValueError:
            messagebox.showerror("Lỗi", "Vui lòng nhập số nguyên hợp lệ!")
        except Exception as e:
            messagebox.showerror("Lỗi", f"Có lỗi xảy ra: {str(e)}")
    
    def save_history(self, N, total):
        """Lưu lịch sử tính toán (có thể mở rộng)"""
        pass  # Có thể thêm tính năng lưu lịch sử

# Phiên bản đơn giản hơn
def simple_version():
    """Phiên bản đơn giản nhất"""
    import tkinter as tk
    
    def calculate():
        try:
            N = int(entry.get())
            total = 0
            for i in range(1, N + 1):
                total += i
            
            # Hiển thị
            result_text = f"1 + 2 + 3 + ... + {N} = {total}"
            label.config(text=result_text)
        except:
            label.config(text="Nhập số hợp lệ!")
    
    window = tk.Tk()
    window.title("Tính tổng dãy số")
    window.geometry("400x200")
    
    tk.Label(window, text="Nhập N:").pack(pady=10)
    entry = tk.Entry(window, width=15)
    entry.pack(pady=5)
    
    tk.Button(window, text="Tính tổng", command=calculate, 
             bg="green", fg="white").pack(pady=10)
    
    label = tk.Label(window, text="", font=("Arial", 12))
    label.pack(pady=10)
    
    window.mainloop()

# Phiên bản với nhiều tính năng hơn
class EnhancedSumCalculator:
    def __init__(self, root):
        self.root = root
        self.root.title("Tính Tổng Dãy Số Nâng Cao")
        self.root.geometry("600x400")
        
        self.create_widgets()
    
    def create_widgets(self):
        # Tiêu đề
        tk.Label(self.root, text="TÍNH TỔNG DÃY SỐ TỪ 1 ĐẾN N",
                font=("Arial", 16, "bold"), fg="navy").pack(pady=20)
        
        # Khung nhập liệu
        frame = tk.Frame(self.root)
        frame.pack(pady=20)
        
        tk.Label(frame, text="Giá trị N:", font=("Arial", 12)).grid(row=0, column=0, padx=5)
        self.entry = tk.Entry(frame, width=20, font=("Arial", 12))
        self.entry.grid(row=0, column=1, padx=5)
        
        # Phương pháp tính
        tk.Label(frame, text="Phương pháp:", font=("Arial", 12)).grid(row=1, column=0, padx=5, pady=10)
        self.method = tk.StringVar(value="vòng lặp")
        methods = ["vòng lặp", "công thức", "đệ quy"]
        tk.OptionMenu(frame, self.method, *methods).grid(row=1, column=1, padx=5, pady=10)
        
        # Nút tính
        tk.Button(self.root, text="TÍNH TOÁN", command=self.calculate,
                 bg="darkgreen", fg="white", font=("Arial", 12),
                 width=15).pack(pady=10)
        
        # Kết quả
        self.result_frame = tk.LabelFrame(self.root, text="Kết quả", 
                                         font=("Arial", 12, "bold"))
        self.result_frame.pack(pady=20, padx=20, fill=tk.BOTH, expand=True)
        
        self.result_text = tk.Text(self.result_frame, height=8, width=50,
                                 font=("Courier", 10))
        self.result_text.pack(padx=10, pady=10, fill=tk.BOTH, expand=True)
        
        # Thời gian thực thi
        self.time_label = tk.Label(self.root, text="", font=("Arial", 10))
        self.time_label.pack(pady=5)
    
    def calculate(self):
        import time
        
        try:
            N = int(self.entry.get())
            method = self.method.get()
            
            start_time = time.time()
            
            if method == "vòng lặp":
                total = 0
                for i in range(1, N + 1):
                    total += i
                method_name = "Vòng lặp for"
                
            elif method == "công thức":
                total = N * (N + 1) // 2
                method_name = "Công thức N*(N+1)/2"
                
            else:  # đệ quy
                total = self.recursive_sum(N)
                method_name = "Đệ quy"
            
            end_time = time.time()
            elapsed = end_time - start_time
            
            # Hiển thị kết quả
            self.result_text.delete(1.0, tk.END)
            result = f"TÍNH TỔNG TỪ 1 ĐẾN {N}\n"
            result += "=" * 40 + "\n\n"
            result += f"Phương pháp: {method_name}\n"
            result += f"Kết quả: {total:,}\n\n"
            
            # Hiển thị chi tiết nếu N nhỏ
            if N <= 20:
                numbers = " + ".join(str(i) for i in range(1, N + 1))
                result += f"Chi tiết: {numbers} = {total}\n"
            
            result += f"\nCông thức kiểm tra: {N}×({N}+1)÷2 = {total}"
            
            self.result_text.insert(1.0, result)
            
            # Thời gian thực thi
            self.time_label.config(text=f"Thời gian: {elapsed:.6f} giây")
            
        except ValueError:
            messagebox.showerror("Lỗi", "Nhập số nguyên hợp lệ!")
    
    def recursive_sum(self, n):
        """Tính tổng bằng đệ quy"""
        if n == 1:
            return 1
        return n + self.recursive_sum(n - 1)

# Chương trình chính
if __name__ == "__main__":
    # Lựa chọn phiên bản
    print("Chọn phiên bản:")
    print("1. Phiên bản đầy đủ (như hình)")
    print("2. Phiên bản đơn giản")
    print("3. Phiên bản nâng cao")
    
    choice = input("Nhập lựa chọn (1-3): ")
    
    root = tk.Tk()
    
    if choice == "1":
        app = SumCalculatorApp(root)
    elif choice == "2":
        simple_version()
    elif choice == "3":
        app = EnhancedSumCalculator(root)
    else:
        app = SumCalculatorApp(root)
    
    root.mainloop()


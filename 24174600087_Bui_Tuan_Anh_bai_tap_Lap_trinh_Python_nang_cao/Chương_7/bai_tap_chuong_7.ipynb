import tkinter as tk
import math

def calculate():
    try:
        m = int(entry_m.get())
        n = int(entry_n.get())
        
        gcd = math.gcd(m, n)
        lcm = abs(m * n) // gcd
        
        result_label.config(text=f"GCD({m},{n}) = {gcd}\nLCM({m},{n}) = {lcm}")
    except:
        result_label.config(text="Nhập số hợp lệ!")


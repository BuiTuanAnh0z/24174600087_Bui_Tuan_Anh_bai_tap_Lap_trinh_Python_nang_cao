import tkinter as tk

def calculate_fare():
    try:
        distance = float(entry_distance.get())
        
        # Tính theo xe 4 chỗ
        if distance <= 0.8:
            fare = 12000
        else:
            fare = 12000
            remaining = distance - 0.8
            
            if remaining <= 30:
                fare += remaining * 15300
            else:
                fare += 30 * 15300
                fare += (remaining - 30) * 12100
        
        result_label.config(text=f"Tổng cước: {fare:,.0f} VNĐ")
    except:
        result_label.config(text="Nhập khoảng cách hợp lệ!")


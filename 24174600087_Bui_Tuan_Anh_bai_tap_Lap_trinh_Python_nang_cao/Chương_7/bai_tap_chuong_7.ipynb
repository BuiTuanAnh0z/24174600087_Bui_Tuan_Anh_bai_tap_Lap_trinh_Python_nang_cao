def calculate_bmi():
    try:
        weight = float(entry_weight.get())
        height = float(entry_height.get())
        
        bmi = weight / (height ** 2)
        
        # Hiển thị BMI
        entry_result.delete(0, tk.END)
        entry_result.insert(0, f"{bmi:.2f}")
        
        # Kết luận
        if bmi < 18.5:
            conclusion = "Thiếu cân"
            color = "blue"
        elif bmi < 25:
            conclusion = "Bình thường"
            color = "green"
        elif bmi < 30:
            conclusion = "Thừa cân"
            color = "orange"
        else:
            conclusion = "Béo phì"
            color = "red"
            
        conclusion_label.config(text=conclusion, fg=color)
    except:
        conclusion_label.config(text="Nhập số hợp lệ!", fg="red")


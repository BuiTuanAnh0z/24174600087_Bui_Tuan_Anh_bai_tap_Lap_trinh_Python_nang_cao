class ProductManager:
    def __init__(self, db_name='product.db'):
        self.db_name = db_name
        self.conn = None
        self.cursor = None
        self.create_database()
    
    def connect(self):
        """Kết nối đến database"""
        try:
            self.conn = sqlite3.connect(self.db_name)
            self.cursor = self.conn.cursor()
            return True
        except sqlite3.Error as error:
            print(f"Lỗi kết nối: {error}")
            return False
    
    def disconnect(self):
        """Ngắt kết nối"""
        if self.cursor:
            self.cursor.close()
        if self.conn:
            self.conn.close()
    
    def create_database(self):
        """Tạo database và bảng nếu chưa tồn tại"""
        if not self.connect():
            return
        
        try:
            # Tạo bảng products
            create_table_sql = """
            CREATE TABLE IF NOT EXISTS products (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                price REAL NOT NULL,
                amount INTEGER NOT NULL
            )
            """
            self.cursor.execute(create_table_sql)
            self.conn.commit()
            print(f"Đã tạo/kết nối database: {self.db_name}")
            
        except sqlite3.Error as error:
            print(f"Lỗi tạo bảng: {error}")
        finally:
            self.disconnect()
    
    def display_products(self):
        """Hiển thị danh sách sản phẩm"""
        if not self.connect():
            return
        
        try:
            self.cursor.execute("SELECT * FROM products ORDER BY id")
            products = self.cursor.fetchall()
            
            if not products:
                print("Không có sản phẩm nào trong kho!")
                return
            
            print("\n" + "=" * 60)
            print("DANH SÁCH SẢN PHẨM")
            print("=" * 60)
            print(f"{'ID':<5} {'Tên sản phẩm':<20} {'Giá (VNĐ)':<15} {'Số lượng':<10}")
            print("-" * 60)
            
            total_value = 0
            for product in products:
                product_value = product[2] * product[3]
                total_value += product_value
                print(f"{product[0]:<5} {product[1]:<20} {product[2]:<15,.0f} {product[3]:<10}")
            
            print("-" * 60)
            print(f"Tổng giá trị tồn kho: {total_value:,.0f} VNĐ")
            print("=" * 60)
            
        except sqlite3.Error as error:
            print(f"Lỗi hiển thị: {error}")
        finally:
            self.disconnect()
    
    def add_product(self):
        """Thêm sản phẩm mới"""
        if not self.connect():
            return
        
        try:
            print("\n" + "-" * 40)
            print("THÊM SẢN PHẨM MỚI")
            print("-" * 40)
            
            name = input("Tên sản phẩm: ").strip()
            if not name:
                print("Tên sản phẩm không được để trống!")
                return
            
            try:
                price = float(input("Giá sản phẩm (VNĐ): "))
                amount = int(input("Số lượng: "))
                
                if price <= 0 or amount < 0:
                    print("Giá và số lượng phải là số dương!")
                    return
                
            except ValueError:
                print("Giá và số lượng phải là số!")
                return
            
            # Thêm sản phẩm
            self.cursor.execute(
                "INSERT INTO products (name, price, amount) VALUES (?, ?, ?)",
                (name, price, amount)
            )
            self.conn.commit()
            print(f"Đã thêm sản phẩm '{name}' thành công!")
            
        except sqlite3.Error as error:
            print(f"Lỗi thêm sản phẩm: {error}")
        finally:
            self.disconnect()
    
    def search_product(self):
        """Tìm kiếm sản phẩm theo tên"""
        if not self.connect():
            return
        
        try:
            print("\n" + "-" * 40)
            print("TÌM KIẾM SẢN PHẨM")
            print("-" * 40)
            
            keyword = input("Nhập tên sản phẩm cần tìm: ").strip()
            
            self.cursor.execute(
                "SELECT * FROM products WHERE name LIKE ? ORDER BY id",
                (f'%{keyword}%',)
            )
            products = self.cursor.fetchall()
            
            if not products:
                print(f"Không tìm thấy sản phẩm có tên chứa '{keyword}'")
                return
            
            print(f"\nTìm thấy {len(products)} sản phẩm:")
            print("-" * 60)
            print(f"{'ID':<5} {'Tên sản phẩm':<20} {'Giá (VNĐ)':<15} {'Số lượng':<10}")
            print("-" * 60)
            
            for product in products:
                print(f"{product[0]:<5} {product[1]:<20} {product[2]:<15,.0f} {product[3]:<10}")
            
        except sqlite3.Error as error:
            print(f"Lỗi tìm kiếm: {error}")
        finally:
            self.disconnect()
    
    def update_product(self):
        """Cập nhật sản phẩm"""
        if not self.connect():
            return
        
        try:
            print("\n" + "-" * 40)
            print("CẬP NHẬT SẢN PHẨM")
            print("-" * 40)
            
            # Hiển thị danh sách trước
            self.cursor.execute("SELECT id, name FROM products ORDER BY id")
            products = self.cursor.fetchall()
            
            if not products:
                print("Không có sản phẩm để cập nhật!")
                return
            
            print("Danh sách ID sản phẩm:")
            for product in products:
                print(f"ID: {product[0]} - Tên: {product[1]}")
            
            try:
                product_id = int(input("\nNhập ID sản phẩm cần cập nhật: "))
            except ValueError:
                print("ID phải là số nguyên!")
                return
            
            # Kiểm tra sản phẩm có tồn tại không
            self.cursor.execute("SELECT * FROM products WHERE id = ?", (product_id,))
            product = self.cursor.fetchone()
            
            if not product:
                print(f"Không tìm thấy sản phẩm có ID = {product_id}")
                return
            
            print(f"\nThông tin hiện tại của sản phẩm:")
            print(f"Tên: {product[1]}")
            print(f"Giá: {product[2]:,.0f} VNĐ")
            print(f"Số lượng: {product[3]}")
            
            # Nhập thông tin mới
            print("\nNhập thông tin mới (bấm Enter để giữ nguyên):")
            
            new_name = input(f"Tên mới [{product[1]}]: ").strip()
            new_price = input(f"Giá mới [{product[2]:,.0f}]: ").strip()
            new_amount = input(f"Số lượng mới [{product[3]}]: ").strip()
            
            # Cập nhật
            name = new_name if new_name else product[1]
            price = float(new_price) if new_price else product[2]
            amount = int(new_amount) if new_amount else product[3]
            
            self.cursor.execute(
                "UPDATE products SET name = ?, price = ?, amount = ? WHERE id = ?",
                (name, price, amount, product_id)
            )
            self.conn.commit()
            
            print(f"Đã cập nhật sản phẩm ID {product_id} thành công!")
            
        except (ValueError, sqlite3.Error) as error:
            print(f"Lỗi cập nhật: {error}")
        finally:
            self.disconnect()
    
    def delete_product(self):
        """Xóa sản phẩm"""
        if not self.connect():
            return
        
        try:
            print("\n" + "-" * 40)
            print("XÓA SẢN PHẨM")
            print("-" * 40)
            
            # Hiển thị danh sách
            self.display_products()
            
            try:
                product_id = int(input("\nNhập ID sản phẩm cần xóa: "))
            except ValueError:
                print("ID phải là số nguyên!")
                return
            
            # Kiểm tra sản phẩm có tồn tại không
            self.cursor.execute("SELECT name FROM products WHERE id = ?", (product_id,))
            product = self.cursor.fetchone()
            
            if not product:
                print(f"Không tìm thấy sản phẩm có ID = {product_id}")
                return
            
            # Xác nhận xóa
            confirm = input(f"Bạn có chắc chắn muốn xóa sản phẩm '{product[0]}'? (y/n): ").lower()
            
            if confirm == 'y':
                self.cursor.execute("DELETE FROM products WHERE id = ?", (product_id,))
                self.conn.commit()
                print(f"Đã xóa sản phẩm ID {product_id} thành công!")
            else:
                print("Đã hủy thao tác xóa.")
            
        except sqlite3.Error as error:
            print(f"Lỗi xóa: {error}")
        finally:
            self.disconnect()
    
    def menu(self):
        """Hiển thị menu chính"""
        while True:
            print("\n" + "=" * 60)
            print("QUẢN LÝ SẢN PHẨM")
            print("=" * 60)
            print("1. Hiển thị danh sách sản phẩm")
            print("2. Thêm sản phẩm mới")
            print("3. Tìm kiếm sản phẩm theo tên")
            print("4. Cập nhật sản phẩm")
            print("5. Xóa sản phẩm")
            print("0. Thoát")
            print("-" * 60)
            
            choice = input("Chọn chức năng (0-5): ").strip()
            
            if choice == '0':
                print("Cảm ơn đã sử dụng chương trình!")
                break
            elif choice == '1':
                self.display_products()
            elif choice == '2':
                self.add_product()
            elif choice == '3':
                self.search_product()
            elif choice == '4':
                self.update_product()
            elif choice == '5':
                self.delete_product()
            else:
                print("Lựa chọn không hợp lệ! Vui lòng chọn lại.")


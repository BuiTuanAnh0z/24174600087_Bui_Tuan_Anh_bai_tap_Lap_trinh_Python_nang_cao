class EmployeeManager:
    def __init__(self, db_name='ql_nhan_vien.db'):
        self.db_name = db_name
        self.create_database()
    
    def create_database(self):
        """Tạo database và các bảng"""
        try:
            conn = sqlite3.connect(self.db_name)
            cursor = conn.cursor()
            
            # Tạo bảng PHONG
            create_phong_table = """
            CREATE TABLE IF NOT EXISTS PHONG (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                ten_phong TEXT NOT NULL,
                mo_ta TEXT
            )
            """
            cursor.execute(create_phong_table)
            
            # Tạo bảng NHAN_VIEN
            create_nhan_vien_table = """
            CREATE TABLE IF NOT EXISTS NHAN_VIEN (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                ho_ten TEXT NOT NULL,
                tuoi INTEGER NOT NULL,
                dia_chi TEXT NOT NULL,
                luong REAL NOT NULL,
                id_phong INTEGER,
                FOREIGN KEY (id_phong) REFERENCES PHONG(id) ON DELETE SET NULL
            )
            """
            cursor.execute(create_nhan_vien_table)
            
            conn.commit()
            print(f"Đã tạo database: {self.db_name}")
            
            # Thêm dữ liệu mẫu cho bảng PHONG
            phong_data = [
                ('Phòng Kinh doanh', 'Phụ trách kinh doanh sản phẩm'),
                ('Phòng Kỹ thuật', 'Phụ trách phát triển sản phẩm'),
                ('Phòng Nhân sự', 'Phụ trách tuyển dụng và quản lý nhân sự'),
                ('Phòng Tài chính', 'Phụ trách tài chính kế toán')
            ]
            
            cursor.executemany(
                "INSERT OR IGNORE INTO PHONG (ten_phong, mo_ta) VALUES (?, ?)",
                phong_data
            )
            
            # Thêm dữ liệu mẫu cho bảng NHAN_VIEN
            nhan_vien_data = [
                ('Nguyễn Văn An', 28, 'Hà Nội', 15000000, 1),
                ('Trần Thị Bình', 32, 'Hồ Chí Minh', 18000000, 2),
                ('Lê Văn Cường', 25, 'Đà Nẵng', 12000000, 1),
                ('Phạm Thị Dung', 30, 'Hải Phòng', 16000000, 3),
                ('Hoàng Văn Em', 27, 'Cần Thơ', 14000000, 2)
            ]
            
            cursor.executemany(
                """INSERT OR IGNORE INTO NHAN_VIEN 
                   (ho_ten, tuoi, dia_chi, luong, id_phong) 
                   VALUES (?, ?, ?, ?, ?)""",
                nhan_vien_data
            )
            
            conn.commit()
            print("Đã thêm dữ liệu mẫu vào các bảng")
            
            cursor.close()
            conn.close()
            
        except sqlite3.Error as error:
            print(f"Lỗi tạo database: {error}")
    
    def display_tables_info(self):
        """Hiển thị thông tin các bảng"""
        try:
            conn = sqlite3.connect(self.db_name)
            cursor = conn.cursor()
            
            print("\nTHÔNG TIN CÁC BẢNG TRONG DATABASE")
            print("-" * 60)
            
            # Hiển thị bảng PHONG
            print("\nBẢNG PHONG:")
            cursor.execute("SELECT * FROM PHONG")
            phong_data = cursor.fetchall()
            
            print(f"{'ID':<5} {'Tên phòng':<20} {'Mô tả':<30}")
            print("-" * 60)
            for row in phong_data:
                print(f"{row[0]:<5} {row[1]:<20} {row[2]:<30}")
            
            # Hiển thị bảng NHAN_VIEN
            print("\n\nBẢNG NHAN_VIEN:")
            cursor.execute("""
                SELECT nv.id, nv.ho_ten, nv.tuoi, nv.dia_chi, 
                       nv.luong, p.ten_phong 
                FROM NHAN_VIEN nv
                LEFT JOIN PHONG p ON nv.id_phong = p.id
                ORDER BY nv.id
            """)
            nhan_vien_data = cursor.fetchall()
            
            print(f"{'ID':<5} {'Họ tên':<20} {'Tuổi':<5} {'Địa chỉ':<15} {'Lương':<15} {'Phòng':<15}")
            print("-" * 90)
            for row in nhan_vien_data:
                print(f"{row[0]:<5} {row[1]:<20} {row[2]:<5} {row[3]:<15} {row[4]:<15,.0f} {row[5]:<15}")
            
            # Thống kê
            print("\n\nTHỐNG KÊ:")
            cursor.execute("SELECT COUNT(*) FROM PHONG")
            so_phong = cursor.fetchone()[0]
            
            cursor.execute("SELECT COUNT(*) FROM NHAN_VIEN")
            so_nhan_vien = cursor.fetchone()[0]
            
            cursor.execute("SELECT AVG(luong) FROM NHAN_VIEN")
            luong_tb = cursor.fetchone()[0]
            
            print(f"Số phòng ban: {so_phong}")
            print(f"Số nhân viên: {so_nhan_vien}")
            print(f"Lương trung bình: {luong_tb:,.0f} VNĐ")
            
            cursor.close()
            conn.close()
            
        except sqlite3.Error as error:
            print(f"Lỗi hiển thị: {error}")

